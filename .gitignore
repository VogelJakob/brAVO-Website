# Lokale Rohdaten (Fotos, Videos, Vita-Texte) – bleiben bewusst außerhalb von Git/GitHub
AVO_Website_Dateien/
AVO-Website/
AVO Website/
# Server-Kopie (IONOS /public) und erzeugter Upload-Ordner für FileZilla
Avo Website alt/
AVO Website upload/

# Medien-Dateien vorerst nur lokal nutzen, nicht committen.
# (Die Ordnerstruktur bleibt über die .gitkeep-Dateien erhalten.)
# Zum späteren Veröffentlichen einzelner Dateien: Zeile entfernen
# oder gezielt mit `git add -f <datei>` hinzufügen.
assets/images/students/*.jpg
assets/videos/*.mp4
assets/audio/*.mp3
assets/audio/*.wav
assets/audio/*.mp4
# Gruppen- und Szenenfotos ebenfalls nur per FileZilla
assets/images/*.jpg
assets/images/productions/*.jpg

# Entwurfsmaterial und lokale Werkzeug-Einstellungen (gehören nicht ins Webroot)
design/
.claude/

# Betriebssystem-Dateien
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# BILDER GEHÖREN NICHT INS REPOSITORY.
# Die Website wird per SFTP deployt; Git versioniert ausschließlich den Code.
# Daher werden Bilddateien generell ignoriert – in JEDEM Ordner und unabhängig
# von der Groß-/Kleinschreibung der Endung (Git-Muster sind case-sensitiv,
# deshalb die Zeichenklassen je Buchstabe).
# Die Ordnerstruktur bleibt über die .gitkeep-Dateien erhalten.
# ---------------------------------------------------------------------------
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[wW][eE][bB][pP]
*.[gG][iI][fF]
*.[hH][eE][iI][cC]
*.[aA][vV][iI][fF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[bB][mM][pP]
*.[sS][vV][gG]
