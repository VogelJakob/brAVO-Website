# =====================================================================
# Cache-Steuerung (Details und Ablauf beim Upload: siehe CACHE.md)
# ---------------------------------------------------------------------
# Alle Regeln stehen in <IfModule>-Blöcken: Fehlt ein Modul auf dem
# Server, werden sie einfach ignoriert statt einen Fehler 500 auszulösen.
# ETag und Last-Modified sendet Apache weiterhin automatisch – der
# Browser fragt also nur kurz nach und lädt eine Datei nur dann neu
# herunter, wenn sie sich wirklich geändert hat (Antwort 304 sonst).
# =====================================================================

# Eventuelle Expires-Vorgaben des Servers abschalten, damit nur die
# Cache-Control-Regeln unten gelten.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>

  # --- HTML-Seiten: immer beim Server nachfragen (gilt in beiden Modi) ---
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # --- MODUS A (AKTIV): Assets ebenfalls immer nachfragen --------------
  # Änderungen an CSS/JS/Daten/Bildern/Medien kommen sofort an, auch
  # wenn die Versionskennung (?v=…) einmal nicht erhöht wurde.
  <FilesMatch "\.(css|js|jpe?g|png|gif|webp|avif|svg|ico|webmanifest|mp3|wav|m4a|ogg|mp4|webm|mov|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # --- MODUS B (für später, auskommentiert): lange Gültigkeit ----------
  # Assets werden ein Jahr ohne Nachfrage aus dem Browser-Cache geladen;
  # für Aktualität sorgt allein die Versionskennung ?v=… in den HTML-
  # Dateien. UMSCHALTEN: den FilesMatch-Block von MODUS A oben mit "#"
  # auskommentieren und bei den drei Zeilen von MODUS B unten das
  # führende "# " entfernen. Zurück auf MODUS A: genau umgekehrt.
  # ACHTUNG: In MODUS B MUSS bei jedem Upload geänderter Assets die
  # Versionskennung erhöht werden, sonst sehen Besucher bis zu ein Jahr
  # lang die alte Datei.
  # <FilesMatch "\.(css|js|jpe?g|png|gif|webp|avif|svg|ico|webmanifest|mp3|wav|m4a|ogg|mp4|webm|mov|woff2?|ttf|otf|eot)$">
  #   Header set Cache-Control "public, max-age=31536000, immutable"
  # </FilesMatch>

</IfModule>
# ===================== Ende Cache-Steuerung ==========================

# =====================================================================
# MIME-Typ für das Web-App-Manifest (site.webmanifest)
# ---------------------------------------------------------------------
# Manche Server kennen die Endung .webmanifest nicht und liefern sie als
# text/plain aus; Browser erwarten application/manifest+json.
# =====================================================================
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
# =================== Ende MIME-Typ Web-App-Manifest ==================

# =====================================================================
# Interne Dateien sperren (Doku, Skripte, Werkzeuge)
# ---------------------------------------------------------------------
# Der Deploy lädt alle nicht versteckten Repo-Dateien nach /public hoch,
# also auch README.md, CACHE.md und tools/. Diese sollen nicht öffentlich
# abrufbar sein. Die Website selbst lädt keine .md-, .py- oder .sh-Dateien.
# =====================================================================

# --- Dateitypen *.md, *.py, *.sh (überall) ----------------------------
<IfModule mod_authz_core.c>
  # Apache 2.4
  <FilesMatch "(?i)\.(md|py|sh)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  # Fallback für ältere Apache-Versionen (2.2)
  <FilesMatch "(?i)\.(md|py|sh)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# --- Ordner tools/ und .github/ komplett sperren (Antwort 403) --------
<IfModule mod_alias.c>
  RedirectMatch 403 ^/(tools|\.github)(/|$)
</IfModule>
# ================== Ende Interne Dateien sperren =====================

# =====================================================================
# PHP-Bibliotheken und PHP-Dateien sperren (AVO-Anmeldeformular)
# ---------------------------------------------------------------------
# lib/ enthält PHPMailer (wird nur von api/avo-anmeldung.php per require
# geladen) und muss nie direkt aufgerufen werden. Außerdem werden alle
# PHP-Dateien gesperrt – einzige Ausnahme ist der Formular-Endpunkt
# avo-anmeldung.php. Neue öffentliche PHP-Skripte müssen hier bewusst
# freigeschaltet werden.
# =====================================================================

# --- Ordner lib/ komplett sperren (Antwort 403) -----------------------
<IfModule mod_alias.c>
  RedirectMatch 403 ^/lib(/|$)
</IfModule>

# --- Alle PHP-Dateien außer avo-anmeldung.php sperren -----------------
<IfModule mod_authz_core.c>
  # Apache 2.4
  <FilesMatch "(?i)^(?!avo-anmeldung\.php$).*\.(php\d?|phtml|phar)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  # Fallback für ältere Apache-Versionen (2.2)
  <FilesMatch "(?i)^(?!avo-anmeldung\.php$).*\.(php\d?|phtml|phar)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
# ============ Ende PHP-Bibliotheken und PHP-Dateien sperren ==========

# =====================================================================
# Eine einzige Adresse pro Seite (SEO): 301-Weiterleitungen
# ---------------------------------------------------------------------
# Hauptvariante ist https://adk-bayern-2027.de (ohne www). Doppelte
# Adressen derselben Seite werden dauerhaft dorthin umgeleitet, damit
# Google sie nicht als getrennte Seiten führt. Fehlt mod_rewrite, wird
# der Block ignoriert. /.well-known/ (SSL-Zertifikatsprüfung) bleibt
# immer unangetastet.
# =====================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- www.adk-bayern-2027.de → adk-bayern-2027.de (gleich mit https) --
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- http → https ----------------------------------------------------
  # Der zweite Check verhindert eine Endlosschleife, falls der Server
  # hinter einem Proxy steht, der https selbst entgegennimmt.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- …/index.html → …/ (Startseite und /links/) ----------------------
  # Nur bei direktem Aufruf (THE_REQUEST); die interne Auslieferung von
  # index.html für "/" löst so keine Schleife aus.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # --- Profil ohne Endung → /students/{slug}.html -----------------------
  RewriteCond %{THE_REQUEST} \s/+students/([^/.?\s]+)/?[\s?]
  RewriteRule ^ /students/%1.html [R=301,L]
</IfModule>
# ================= Ende Weiterleitungen (eine Adresse) ===============
